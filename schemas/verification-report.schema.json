{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork independent Apple Photos verification report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "verification_kind",
    "verified_at",
    "plan_id",
    "plan_sha256",
    "release_candidate_sha256",
    "release_seal_sha256",
    "catalog_plan_sha256",
    "master_assignment_sha256",
    "source_membership_sha256",
    "source_count",
    "verified_album_count",
    "unexpected_membership_count",
    "missing_membership_count",
    "outside_source_count",
    "publication_clearance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "PASS"},
    "verification_kind": {"const": "independent-read-only-photos-sqlite"},
    "verified_at": {"type": "string"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release_candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release_seal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "catalog_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "master_assignment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_membership_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_count": {"type": "integer", "minimum": 1},
    "verified_album_count": {"type": "integer", "minimum": 1},
    "unexpected_membership_count": {"const": 0},
    "missing_membership_count": {"const": 0},
    "outside_source_count": {"const": 0},
    "publication_clearance": {"const": false}
  },
  "additionalProperties": false
}
