{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork retrieval specification",
  "type": "object",
  "required": ["views"],
  "properties": {
    "seed": {"type": "integer"},
    "candidate_multiplier": {"type": "number", "minimum": 1},
    "excluded_album_terms": {"type": "array", "items": {"type": "string"}},
    "prior_corpus_album_title": {"type": "string"},
    "minimum_outside_prior_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "quota"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "quota": {"type": "integer", "minimum": 0},
          "terms": {"type": "array", "items": {"type": "string"}},
          "people": {"type": "array", "items": {"type": "string"}},
          "albums": {"type": "array", "items": {"type": "string"}},
          "places": {"type": "array", "items": {"type": "string"}},
          "search_terms": {"type": "array", "items": {"type": "string"}},
          "year_start": {"type": ["integer", "null"]},
          "year_end": {"type": ["integer", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
