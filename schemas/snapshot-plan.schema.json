{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jamie Photo Archive membership snapshot plan",
  "type": "object",
  "required": [
    "operation", "schema_version", "plan_id", "workspace_path", "safety_mode",
    "source_album_identifier", "expected_source_count", "batch_size", "log_path",
    "receipt_path", "folders", "albums", "master_sha256", "proposal_id"
  ],
  "properties": {
    "operation": {"const": "snapshot-membership"},
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "workspace_path": {"type": "string", "pattern": "^/"},
    "safety_mode": {"const": "create-folders-albums-and-add-membership-only"},
    "source_album_identifier": {"type": "string", "minLength": 1},
    "expected_source_count": {"type": "integer", "minimum": 1},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 2000},
    "log_path": {"type": "string", "pattern": "^/"},
    "receipt_path": {"type": "string", "pattern": "^/"},
    "master_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposal_id": {"type": "string", "minLength": 1},
    "folders": {"type": "array"},
    "albums": {"type": "array"}
  }
}
