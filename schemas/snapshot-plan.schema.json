{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhouse.github.io/photo-fieldwork/schemas/snapshot-plan.schema.json",
  "title": "Photo Fieldwork snapshot membership plan",
  "type": "object",
  "required": ["operation", "schema_version", "plan_id", "safety_mode", "source_album_identifier", "expected_source_count", "folders", "albums"],
  "properties": {
    "operation": {"const": "snapshot-membership"},
    "schema_version": {"const": 1},
    "plan_id": {"type": "string"},
    "safety_mode": {"const": "create-folders-albums-and-add-membership-only"},
    "source_album_identifier": {"type": "string"},
    "expected_source_count": {"type": "integer", "minimum": 0},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 2000},
    "folders": {"type": "array", "items": {"type": "object"}},
    "albums": {"type": "array", "items": {"type": "object"}},
    "manifest_hashes": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
