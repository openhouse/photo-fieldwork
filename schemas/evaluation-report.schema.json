{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork evaluation report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "proposal_id", "master_sha256", "sample_sha256", "config_sha256",
    "source_fingerprint", "evaluation_scope", "required_release_class", "master_bound",
    "source_bound", "sample_completion", "fresh_sample_completion", "fresh_decisive_precision",
    "master_review_fraction", "quality_passed", "passed", "by_view"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "proposal_id": {"type": "string"},
    "master_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sample_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_fingerprint": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "evaluation_scope": {"enum": ["learning-sample", "final-stratified-sample", "full-master", "publication-shortlist"]},
    "required_release_class": {"enum": ["editor-field-verified", "master-human-reviewed", "publication-ready"]},
    "release_class": {"type": ["string", "null"]},
    "master_bound": {"type": "boolean"},
    "source_bound": {"type": "boolean"},
    "sample_completion": {"type": "number", "minimum": 0, "maximum": 1},
    "fresh_sample_completion": {"type": "number", "minimum": 0, "maximum": 1},
    "fresh_decisive_precision": {"type": "number", "minimum": 0, "maximum": 1},
    "master_review_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "quality_passed": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "by_view": {"type": "object"}
  }
}
