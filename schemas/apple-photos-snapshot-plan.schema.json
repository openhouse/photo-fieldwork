{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork Apple Photos snapshot plan",
  "type": "object",
  "required": ["operation", "schema_version", "plan_id", "plan_sha256", "safety_mode", "source_album_identifier", "expected_source_count", "source_membership_sha256", "publication_approval_default", "batch_size", "receipt_path", "folders", "albums"],
  "properties": {
    "operation": {"const": "snapshot-membership"},
    "schema_version": {"const": 2},
    "plan_id": {"type": "string"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safety_mode": {"const": "create-folders-albums-and-add-membership-only"},
    "source_album_identifier": {"type": "string"},
    "expected_source_count": {"type": "integer", "minimum": 1},
    "source_membership_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "publication_approval_default": {"const": "not-approved"},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 2000},
    "receipt_path": {"type": "string"},
    "folders": {"type": "array"},
    "albums": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "parent_folder_key", "asset_identifiers", "membership_sha256"]
      }
    }
  }
}
