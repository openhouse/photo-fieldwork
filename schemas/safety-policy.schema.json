{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork relational safety policy",
  "type": "object",
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relation", "values", "action", "reason"],
        "properties": {
          "id": {"type": "string"},
          "relation": {"enum": ["uuid", "persons", "albums", "event_cluster", "labels"]},
          "match": {"enum": ["exact", "contains"]},
          "values": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "action": {"enum": ["needs-review", "hold"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
