{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork Apple Photos writer receipt",
  "type": "object",
  "required": ["completed_at", "plan_id", "plan_sha256", "source_album_identifier", "source_count", "source_membership_sha256"],
  "properties": {
    "completed_at": {"type": "string"},
    "plan_id": {"type": "string"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_album_identifier": {"type": "string"},
    "source_count": {"type": "integer", "minimum": 1},
    "source_membership_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "external_uploads_performed": {"const": false}
  }
}
