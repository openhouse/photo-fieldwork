{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhouse.github.io/photo-fieldwork/schemas/run-state.schema.json",
  "title": "Photo Fieldwork run state",
  "type": "object",
  "required": ["schema_version", "run_id", "version", "status", "target_count", "source", "phases"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["initialized", "in-progress", "ready-to-finalize", "complete"]},
    "target_count": {"type": "integer", "minimum": 1},
    "config_hash": {"type": ["string", "null"]},
    "code_version": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "required": ["identifier", "expected_count"],
      "properties": {
        "identifier": {"type": "string"},
        "expected_count": {"type": "integer", "minimum": 0}
      }
    },
    "phases": {"type": "object"},
    "history": {"type": "array"}
  }
}
