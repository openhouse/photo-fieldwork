{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork run state",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "source", "target_count", "phases", "history"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string"},
    "status": {"enum": ["initialized", "active", "complete"]},
    "source": {
      "type": "object",
      "required": ["id", "expected_count"],
      "properties": {
        "id": {"type": "string"},
        "expected_count": {"type": "integer", "minimum": 1},
        "profile_fingerprint": {"type": ["string", "null"]}
      }
    },
    "target_count": {"type": "integer", "minimum": 1},
    "phases": {"type": "object", "additionalProperties": {"enum": ["pending", "in_progress", "completed", "blocked"]}},
    "history": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
