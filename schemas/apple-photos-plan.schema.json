{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork Apple Photos membership plan",
  "type": "object",
  "required": [
    "operation",
    "schema_version",
    "plan_id",
    "safety_mode",
    "source_album_identifier",
    "expected_source_count",
    "batch_size",
    "receipt_path",
    "folders",
    "albums"
  ],
  "properties": {
    "operation": {"const": "snapshot-membership"},
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "safety_mode": {"const": "create-folders-albums-and-add-membership-only"},
    "source_album_identifier": {"type": "string", "minLength": 1},
    "expected_source_count": {"type": "integer", "minimum": 1},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 2000},
    "log_path": {"type": "string"},
    "receipt_path": {"type": "string", "minLength": 1},
    "folders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "title", "parent_key", "existing_identifier"],
        "properties": {
          "key": {"type": "string"},
          "title": {"type": "string"},
          "parent_key": {"type": ["string", "null"]},
          "existing_identifier": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "albums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "parent_folder_key", "existing_identifier", "asset_identifiers"],
        "properties": {
          "title": {"type": "string"},
          "parent_folder_key": {"type": "string"},
          "existing_identifier": {"type": ["string", "null"]},
          "asset_identifiers": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "/L0/001$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
