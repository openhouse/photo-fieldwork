{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork evaluation feedback row",
  "type": "object",
  "required": ["uuid", "primary_view", "judgment", "visible_reason", "safety_status", "error_category", "round_id", "reviewer_lens"],
  "properties": {
    "uuid": {"type": "string", "minLength": 1},
    "primary_view": {"type": "string", "minLength": 1},
    "judgment": {"enum": ["fit", "reject", "uncertain"]},
    "visible_reason": {"type": "string", "minLength": 1},
    "safety_status": {"enum": ["clear", "needs-review", "hold"]},
    "error_category": {"enum": ["retrieval-mismatch", "context-collapse", "taxonomy-coercion", "privacy-miss", "relationship-loss", "temporal-distortion", "redundancy", "aesthetic-overreach", "visible-fit"]},
    "round_id": {"type": "string", "minLength": 1},
    "reviewer_lens": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
