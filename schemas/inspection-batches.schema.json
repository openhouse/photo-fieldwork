{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork inspection batch manifest",
  "type": "object",
  "required": ["schema_version", "batches"],
  "properties": {
    "schema_version": {"const": 1},
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["inspection_jsonl", "helper_version", "target_long_edge", "classifier_policy", "safety_ruleset_version", "source_fingerprint"],
        "properties": {
          "inspection_jsonl": {"type": "string"},
          "preview_directory": {"type": ["string", "null"]},
          "helper_version": {"type": "string"},
          "target_long_edge": {"type": "integer", "minimum": 1},
          "classifier_policy": {"type": "string"},
          "safety_ruleset_version": {"type": "string"},
          "source_fingerprint": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
