{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork membership-only catalog plan",
  "type": "object",
  "required": ["schema_version", "plan_id", "plan_sha256", "safety_mode", "source", "master_membership_sha256", "albums"],
  "properties": {
    "schema_version": {"const": 2},
    "plan_id": {"type": "string"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safety_mode": {"const": "create-folders-albums-and-add-membership-only"},
    "source": {
      "type": "object",
      "required": ["title", "identifier", "count", "membership_sha256"],
      "properties": {
        "title": {"type": "string"},
        "identifier": {"type": "string"},
        "count": {"type": "integer", "minimum": 1},
        "membership_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "master_membership_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "publication_approval_default": {"const": "not-approved"},
    "albums": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "title", "asset_ids", "membership_sha256"]
      }
    }
  }
}
