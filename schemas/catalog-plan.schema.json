{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork sealed catalog plan",
  "type": "object",
  "required": ["schema_version", "plan_id", "plan_sha256", "safety_mode", "albums"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 2},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposal_id": {"type": "string"},
    "master_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safety_mode": {"const": "create-folders-albums-and-add-membership-only"},
    "source_album_identifier": {"type": "string"},
    "expected_source_count": {"type": "integer", "minimum": 1},
    "source_membership_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation": {
      "type": "object",
      "required": ["proposal_id", "master_sha256", "passed"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "master_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "passed": {"const": true}
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "identifier": {"type": "string"}
      },
      "required": ["identifier"]
    },
    "adapter": {
      "type": "object",
      "properties": {"name": {"type": "string"}},
      "required": ["name"]
    },
    "albums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "key": {"type": "string"},
          "title": {"type": "string"},
          "asset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "asset_identifiers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "oneOf": [{"required": ["asset_ids"]}, {"required": ["asset_identifiers"]}]
      }
    }
  }
}
