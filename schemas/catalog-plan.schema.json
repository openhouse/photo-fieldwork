{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photo-fieldwork.local/schemas/catalog-plan.schema.json",
  "title": "Photo Fieldwork release-bound catalog plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "proposal_id",
    "master_sha256",
    "plan_sha256",
    "created_at",
    "safety_mode",
    "source",
    "evaluation",
    "validation",
    "expected_master_count",
    "write_test_count",
    "albums",
    "required_verification"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "plan_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "pattern": "^pfp-[0-9a-f]{16}$"},
    "master_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "safety_mode": {"const": "create-folders-albums-and-add-membership-only"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "identifier", "count", "membership_sha256"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1},
        "membership_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "final_field_audit", "proposal_id", "master_sha256", "report_sha256"],
      "properties": {
        "passed": {"const": true},
        "final_field_audit": {"const": true},
        "proposal_id": {"type": "string", "pattern": "^pfp-[0-9a-f]{16}$"},
        "master_sha256": {"$ref": "#/$defs/sha256"},
        "report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "proposal_id", "master_sha256", "report_sha256"],
      "properties": {
        "status": {"const": "PASS"},
        "proposal_id": {"type": "string", "pattern": "^pfp-[0-9a-f]{16}$"},
        "master_sha256": {"$ref": "#/$defs/sha256"},
        "report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "expected_master_count": {"type": "integer", "minimum": 1},
    "write_test_count": {"type": "integer", "minimum": 1, "maximum": 10},
    "albums": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "asset_ids"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "asset_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "required_verification": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
