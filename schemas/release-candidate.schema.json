{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photo-fieldwork.local/schemas/release-candidate.schema.json",
  "title": "Photo Fieldwork release candidate",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "release_candidate_sha256",
    "release_class",
    "publication_clearance",
    "proposal_id",
    "source_fingerprint",
    "source_membership_sha256",
    "config_sha256",
    "master_sha256",
    "hold_sha256",
    "evaluation_sample_sha256",
    "evaluation_report_sha256",
    "validation_report_sha256",
    "evaluation_split_sha256",
    "evaluation_split_report_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "pattern": "^pfc-[a-f0-9]{20}$"},
    "release_candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release_class": {"enum": ["editor-field-verified", "publication-ready"]},
    "publication_clearance": {"type": "boolean"},
    "proposal_id": {"type": "string", "pattern": "^pfp-[a-f0-9]{16}$"},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_membership_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "master_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hold_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_sample_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validation_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_split_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_split_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "master_count": {"type": "integer", "minimum": 1},
    "hold_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
