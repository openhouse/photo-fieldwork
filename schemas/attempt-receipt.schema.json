{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photo Fieldwork immutable write-attempt receipt",
  "type": "object",
  "required": ["schema_version", "attempt_id", "execution_nonce", "captured_at", "plan_id", "plan_sha256", "execution_fingerprint", "receipt"],
  "properties": {
    "schema_version": {"const": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "execution_nonce": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "captured_at": {"type": "string"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_fingerprint": {
      "type": "object",
      "required": ["app_bundle_identifier", "app_binary_sha256", "plan_sha256"],
      "properties": {
        "app_bundle_identifier": {"type": "string", "minLength": 3},
        "app_binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "receipt": {"type": "object"}
  },
  "additionalProperties": false
}
