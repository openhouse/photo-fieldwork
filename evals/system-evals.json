{
  "schema_version": 1,
  "suite": "revision-D-critical-contracts",
  "description": "Synthetic, local-only adversarial evaluations distilled from the feature/revision-* fieldwork family.",
  "default_max_depth": 5,
  "cases": [
    {
      "id": "selection-order-invariance",
      "category": "selection",
      "runner": "selection_order",
      "max_depth": 4,
      "mutations": ["reverse", "rotate", "identifier-suffix", "mixed-identifier-suffix"],
      "contract": "Exact assignments remain deterministic under harmless representation changes."
    },
    {
      "id": "safety-fails-closed",
      "category": "safety",
      "runner": "safety_states",
      "max_depth": 1,
      "mutations": ["needs-review", "machine-suspected", "human-confirmed-hold", "editor-only", "unknown", "missing-state"],
      "contract": "Only explicitly clear assets can enter a production-configured master."
    },
    {
      "id": "master-hold-publication-boundary",
      "category": "release",
      "runner": "validation_boundary",
      "max_depth": 3,
      "mutations": ["canonical-hold-overlap", "canonical-master-duplicate", "publication-approved"],
      "contract": "Canonical HOLD overlap, duplicate identities, and publication-approved states block validation."
    },
    {
      "id": "evaluation-sample-integrity",
      "category": "evaluation",
      "runner": "evaluation_integrity",
      "max_depth": 5,
      "mutations": ["drop-view", "underpower-view", "substitute-uuid", "duplicate-uuid", "swap-view-labels"],
      "contract": "Frozen asset-and-view identity and per-view sufficiency prevent aggregate metrics from hiding missing or relabeled evidence."
    },
    {
      "id": "feedback-identity",
      "category": "evaluation",
      "runner": "feedback_identity",
      "max_depth": 5,
      "mutations": ["reverse", "drop-row", "unknown-uuid", "duplicate-uuid", "strip-binding"],
      "contract": "Feedback is order-independent but rejects missing, unknown, substituted, or duplicate identities."
    },
    {
      "id": "checkpoint-chain-integrity",
      "category": "recovery",
      "runner": "checkpoint_chain",
      "max_depth": 2,
      "mutations": ["tamper-prior-artifact", "remove-prior-artifact"],
      "contract": "Every completed checkpoint remains digest-valid before a later phase can advance."
    },
    {
      "id": "inspection-shard-integrity",
      "category": "inspection",
      "runner": "inspection_shards",
      "max_depth": 5,
      "mutations": ["substitute-row", "drop-row", "receipt-count", "source-digest", "source-count"],
      "contract": "Each shard must exactly match its plan, receipt, and frozen source before combination."
    },
    {
      "id": "public-handoff-boundary",
      "category": "privacy",
      "runner": "handoff_boundary",
      "max_depth": 5,
      "mutations": ["email", "posix-path", "windows-path", "phone", "photos-identifier"],
      "contract": "Public handoffs reject operational identifiers and contact details under single and compound leaks."
    },
    {
      "id": "plan-content-addressing",
      "category": "catalog",
      "runner": "plan_binding",
      "max_depth": 4,
      "mutations": ["plan-id", "album-membership", "source-membership", "publication-default"],
      "contract": "Any material plan mutation invalidates its digest and publication remains closed."
    },
    {
      "id": "unclassified-honesty",
      "category": "editorial",
      "runner": "unclassified_honesty",
      "max_depth": 3,
      "mutations": ["unknown-view", "empty-evidence", "input-reorder"],
      "contract": "Unsupported hypotheses fall back to the unclassified editor field without invented evidence."
    }
  ]
}
